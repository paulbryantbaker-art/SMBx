mobile-shots/

# studio/drafts/ — what scripts/studio/pull-queue.mjs writes: the decisions
# made in the app (template pick, edited copy) handed to a Cowork session
# before it renders. A hand-off, not a record: the record is the row in the
# app until the plan markdown catches up. Ignored here (the root file) rather
# than in studio/.gitignore because the pull script is Claude Code's side of
# the boundary. (2026-08-19)
studio/drafts/


# Python bytecode from the studio scripts (figure-deck.py, offer-docs.py…) — build litter, never source. (2026-08-19)
__pycache__/
*.pyc
